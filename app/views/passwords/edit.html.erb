<% content_for :title, "Update your password | JobFlow" %>

<div class="mx-auto w-full max-w-md">
  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <h1 class="text-2xl font-bold tracking-tight text-slate-950">Update your password</h1>
    <p class="mt-2 text-sm text-slate-600">Choose a new password for your JobFlow account.</p>

    <%= form_with url: password_path(params[:token]), method: :put, class: "mt-6 space-y-5" do |form| %>
      <%= form.hidden_field :email_address, id: "reset_email_address", value: @user.email_address, autocomplete: "username" %>
      <div>
        <%= render "shared/password_field", form: form, field: :password, label: "New password", autocomplete: "new-password", options: { minlength: 15, "aria-describedby": "password-requirements" } %>
        <p id="password-requirements" class="mt-2 text-sm text-slate-600">Use at least 15 characters. Passphrases and spaces are welcome.</p>
      </div>
      <div>
        <%= render "shared/password_field", form: form, field: :password_confirmation, label: "Confirm new password", autocomplete: "new-password", options: { maxlength: 72 } %>
      </div>

      <%= form.submit "Save password", class: "w-full inline-block cursor-pointer rounded-lg bg-slate-900 px-4 py-2.5 text-center text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
    <% end %>
  </div>

  <div class="mt-6 text-center text-sm text-slate-600">
    <%= link_to "Back to sign in", new_session_path, class: "font-semibold text-slate-700 underline underline-offset-4 hover:text-slate-950 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 py-2" %>
  </div>
</div>
