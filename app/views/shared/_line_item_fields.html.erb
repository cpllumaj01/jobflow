<div data-testid="line-item" data-nested-line-items-target="row"
    data-persisted="<%= line_item_form.object.persisted? %>"
    <%= "hidden" if line_item_form.object.marked_for_destruction? %>>
  <div class="grid grid-cols-2 gap-4 px-4 py-5 sm:px-6 lg:grid-cols-12 lg:items-start">
    <div class="col-span-2 min-w-0 lg:col-span-6">
      <%= line_item_form.label :description,
          class: "block text-sm font-medium text-slate-700" %>

      <%= line_item_form.text_field :description, **field_error_attributes(line_item_form, :description),
          class: "mt-2 block min-w-0 w-full rounded-lg border border-slate-400 bg-white px-3 py-2.5 text-base sm:text-sm text-slate-950 shadow-sm focus:border-slate-500 transition-colors hover:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-500" %>
      <%= field_errors(line_item_form, :description) %>
    </div>

    <div class="min-w-0 lg:col-span-2">
      <%= line_item_form.label :quantity,
          class: "block text-sm font-medium text-slate-700" %>

      <%= line_item_form.number_field :quantity, **field_error_attributes(line_item_form, :quantity),
          step: 0.01,
          class: "mt-2 block min-w-0 w-full rounded-lg border border-slate-400 bg-white px-3 py-2.5 text-base sm:text-sm text-slate-950 shadow-sm focus:border-slate-500 transition-colors hover:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-500" %>
      <%= field_errors(line_item_form, :quantity) %>
    </div>

    <div class="min-w-0 lg:col-span-3">
      <%= line_item_form.label :unit_price, "Unit price",
          class: "block text-sm font-medium text-slate-700" %>

      <%= line_item_form.number_field :unit_price, **field_error_attributes(line_item_form, :unit_price),
          step: 0.01,
          class: "mt-2 block min-w-0 w-full rounded-lg border border-slate-400 bg-white px-3 py-2.5 text-base sm:text-sm text-slate-950 shadow-sm focus:border-slate-500 transition-colors hover:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-500" %>
      <%= field_errors(line_item_form, :unit_price) %>
    </div>

    <div class="col-span-2 lg:col-span-1 lg:pt-7">
      <%= line_item_form.hidden_field :_destroy,
          value: line_item_form.object.marked_for_destruction? ? "1" : "0",
          data: { nested_line_items_target: "destroy" } %>
      <button type="button" data-action="nested-line-items#remove"
          class="cursor-pointer min-h-11 whitespace-nowrap rounded py-2 text-sm text-slate-500 hover:text-red-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-500">
        Remove
      </button>
    </div>
  </div>
</div>
