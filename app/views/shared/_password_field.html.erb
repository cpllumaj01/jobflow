<% options = local_assigns.fetch(:options, {}) %>
<% field_id = options.fetch(:id) { form.field_id(field) } %>

<%= form.label field, label, for: field_id, class: "block text-sm font-medium text-slate-700" %>
<div class="relative mt-2" data-controller="password-visibility" data-password-visibility-label-value="<%= label.downcase %>" data-action="turbo:before-cache@document->password-visibility#hide">
  <%= form.password_field field, **options, id: field_id, required: true, autocomplete: autocomplete,
        data: { password_visibility_target: "input" },
        class: "block w-full rounded-lg border border-slate-300 bg-white py-2.5 pl-3 pr-12 text-sm text-slate-900 shadow-sm focus:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-500 transition-colors hover:border-slate-400" %>
  <button type="button" hidden aria-label="Show <%= label.downcase %>" aria-controls="<%= field_id %>"
          data-password-visibility-target="toggle" data-action="pointerdown->password-visibility#keepInputFocus click->password-visibility#toggle"
          class="absolute inset-y-0 right-0 flex min-h-11 w-11 cursor-pointer items-center justify-center rounded-r-lg text-slate-500 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900">
    <span data-password-visibility-target="showIcon">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12s3.5-7.5 9.75-7.5 9.75 7.5 9.75 7.5-3.5 7.5-9.75 7.5S2.25 12 2.25 12Z" />
        <circle cx="12" cy="12" r="3" />
      </svg>
    </span>
    <span hidden data-password-visibility-target="hideIcon">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
        <path stroke-linecap="round" stroke-linejoin="round" d="m3 3 18 18M10.6 4.6c.5-.1.9-.1 1.4-.1 6.25 0 9.75 7.5 9.75 7.5a19 19 0 0 1-3.1 4.3M6.1 6.1A21 21 0 0 0 2.25 12s3.5 7.5 9.75 7.5c1.6 0 3.1-.5 4.4-1.3M9.9 9.9a3 3 0 0 0 4.2 4.2" />
      </svg>
    </span>
  </button>
</div>
