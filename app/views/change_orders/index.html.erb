<% content_for :title, "Change orders" %>

<div class="mx-auto max-w-5xl">
  <div class="flex items-start justify-between gap-6">
    <div>
      <%= link_to "← #{@job.name}",
          job_path(@job),
          class: "text-sm font-medium text-slate-500 hover:text-slate-900 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 hover:underline underline-offset-4 py-2" %>

      <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">
        Change orders
      </h1>

      <p class="mt-2 text-slate-600">
        Track additional or revised work for
        <span class="font-medium text-slate-900"><%= @job.name %></span>.
      </p>
    </div>

    <%= link_to "New change order",
        new_job_change_order_path(@job),
        class: "inline-block cursor-pointer rounded-lg bg-slate-900 px-4 py-2.5 text-center text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
  </div>

  <div class="mt-8 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <% if @change_orders.any? %>
      <table class="w-full text-left text-sm">
        <thead class="border-b border-slate-200 bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-6 py-3">Change order</th>
            <th class="px-6 py-3">Status</th>
            <th class="px-6 py-3 text-right">Amount</th>
            <th class="px-6 py-3 text-right"></th>
          </tr>
        </thead>

        <tbody class="divide-y divide-slate-100">
          <% @change_orders.each do |change_order| %>
            <tr class="hover:bg-slate-50">
              <td class="px-6 py-4">
              <div class="font-medium text-slate-950">
                <%= link_to change_order.title,
                    job_change_order_path(@job, change_order),
                    class: "hover:text-slate-600 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 hover:underline underline-offset-4 py-2" %>
              </div>

                <% if change_order.description.present? %>
                  <div class="mt-1 max-w-xl truncate text-sm text-slate-500">
                    <%= change_order.description %>
                  </div>
                <% end %>
              </td>

              <td class="px-6 py-4">
                <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">
                  <%= change_order.status.humanize %>
                </span>
              </td>

              <td class="px-6 py-4 text-right font-medium text-slate-950">
                <%= number_to_currency(change_order.total) %>
              </td>

              <td class="px-6 py-4 text-right">
                <%= link_to "View",
                    job_change_order_path(@job, change_order),
                    class: "font-medium text-slate-700 hover:text-slate-950 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 hover:underline underline-offset-4 py-2" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="px-6 py-12 text-center">
        <h2 class="font-semibold text-slate-950">
          No change orders yet
        </h2>

        <p class="mt-1 text-sm text-slate-500">
          Add a change order when the scope or cost of the job changes.
        </p>

        <%= link_to "Create a change order",
            new_job_change_order_path(@job),
            class: "mt-4 inline-block cursor-pointer rounded-lg bg-slate-900 px-4 py-2.5 text-center text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
      </div>
    <% end %>
  </div>
</div>
