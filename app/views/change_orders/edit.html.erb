<% content_for :title, "Edit change order" %>

<div class="mx-auto max-w-4xl">
  <div class="mb-8">
    <%= link_to "← #{@change_order.title}",
        job_change_order_path(@job, @change_order),
        class: "text-sm font-medium text-slate-500 hover:text-slate-900" %>

    <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">
      Edit change order
    </h1>

    <p class="mt-2 text-slate-600">
      Update the scope and pricing for this change order.
    </p>
  </div>

  <%= render "form", change_order: @change_order, job: @job %>
</div>
