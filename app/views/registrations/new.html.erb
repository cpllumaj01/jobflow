<% content_for :title, "Create your JobFlow account | JobFlow" %>

<div class="mx-auto w-full max-w-md">
  <div class="rounded-xl border border-slate-300 bg-white p-6 shadow-sm sm:p-8">
    <h1 class="text-2xl font-bold tracking-tight text-slate-950">Create your JobFlow account</h1>
    <p class="mt-2 text-sm text-slate-600">Keep your customers, jobs, and project details in one place.</p>

    <%= form_with model: @user, url: sign_up_path, class: "mt-6 space-y-5" do |form| %>
      <%= render "shared/form_errors", record: @user, inline_fields: %w[email_address password password_confirmation] %>
      <div>
        <%= form.label :email_address, "Email address", class: "block text-sm font-medium text-slate-700" %>
        <%= form.email_field :email_address, **field_error_attributes(form, :email_address), required: true, autofocus: true, autocomplete: "username", class: "mt-2 block w-full rounded-lg border border-slate-400 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm focus:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-500 transition-colors hover:border-slate-500" %>
        <%= field_errors(form, :email_address) %>
      </div>
      <div>
        <%= render "shared/password_field", form: form, field: :password, label: "Password", autocomplete: "new-password", inline_errors: true, options: { minlength: 15, "aria-describedby": "password-requirements" } %>
        <p id="password-requirements" class="mt-2 text-sm text-slate-600">Use at least 15 characters. Passphrases and spaces are welcome.</p>
      </div>
      <div>
        <%= render "shared/password_field", form: form, field: :password_confirmation, label: "Confirm password", autocomplete: "new-password", inline_errors: true %>
      </div>

      <%= form.submit "Create account", class: "w-full inline-block cursor-pointer rounded-lg bg-slate-900 px-4 py-2.5 text-center text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
    <% end %>
  </div>

  <div class="mt-6 text-center text-sm text-slate-600">
    <p>Already have an account? <%= link_to "Sign in", new_session_path, class: "font-semibold text-slate-700 underline underline-offset-4 hover:text-slate-950 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 py-2" %></p>
  </div>
</div>
