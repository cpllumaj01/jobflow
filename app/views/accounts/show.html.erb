<% content_for :title, "Account | JobFlow" %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div class="mx-auto w-full max-w-xl space-y-6">
  <h1 class="text-2xl font-bold tracking-tight text-slate-950">Account</h1>

  <section aria-labelledby="account-details-heading" class="rounded-xl border border-slate-300 bg-white p-6 shadow-sm sm:p-8">
    <h2 id="account-details-heading" class="text-lg font-semibold text-slate-950">Your details</h2>
    <dl class="mt-4 text-sm">
      <dt class="font-medium text-slate-700">Email address</dt>
      <dd class="mt-1 break-all text-slate-600"><%= Current.user.email_address %></dd>
    </dl>
  </section>

  <section aria-labelledby="security-heading" class="rounded-xl border border-slate-300 bg-white p-6 shadow-sm sm:p-8">
    <h2 id="security-heading" class="text-lg font-semibold text-slate-950">Security</h2>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
      <h3 class="text-sm font-medium text-slate-700">Two-factor authentication</h3>
      <% if Current.user.two_factor_enabled? %>
        <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-800 ring-1 ring-emerald-600/20 ring-inset">Enabled</span>
      <% else %>
        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 ring-1 ring-slate-600/20 ring-inset">Not enabled</span>
      <% end %>
    </div>
    <p class="mt-3 text-sm text-slate-600"><%= Current.user.two_factor_enabled? ? "Your authenticator adds a second step when signing in." : "Add an authenticator app to protect your account when signing in." %></p>
    <%= link_to Current.user.two_factor_enabled? ? "Manage two-factor authentication" : "Enable two-factor authentication", account_security_path,
        class: "mt-5 inline-flex min-h-11 items-center justify-center rounded-lg bg-slate-900 px-4 py-2.5 text-center text-sm font-semibold text-white shadow-sm hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
  </section>
</div>
