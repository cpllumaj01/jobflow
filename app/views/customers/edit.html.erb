<% content_for :title, "Edit #{@customer.name}" %>

<div class="mx-auto max-w-3xl">
  <div class="mb-8">
    <%= link_to "← #{@customer.name}",
        customer_path(@customer),
        class: "text-sm font-medium text-slate-500 hover:text-slate-900" %>

    <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">
      Edit customer
    </h1>

    <p class="mt-2 text-slate-600">
      Update customer contact information and details.
    </p>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <%= render "form", customer: @customer %>
  </div>
</div>
