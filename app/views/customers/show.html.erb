<p style="color: green"><%= notice %></p>

<%= render @customer %>

<div>
  <%= link_to "Edit this customer", edit_customer_path(@customer) %> |
  <%= link_to "Back to customers", customers_path %>

  <%= button_to "Destroy this customer", @customer, method: :delete %>
</div>

<div class="mt-10">
  <div class="flex items-center justify-between mb-4">
    <h2 class="font-bold text-2xl">Jobs</h2>

    <%= link_to "New job",
      new_job_path(customer_id: @customer.id),
      class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
  </div>

  <% if @jobs.any? %>
    <div class="space-y-3">
      <% @jobs.each do |job| %>
        <div class="border border-gray-200 rounded-lg p-4">
          <div class="flex items-center justify-between">
            <div>
              <%= link_to job.name, job, class: "font-semibold text-lg text-blue-600 hover:underline" %>
              <p class="text-sm text-gray-500"><%= job.status.humanize %></p>
            </div>

            <%= link_to "View", job, class: "text-sm text-gray-700 underline hover:no-underline" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500">No jobs yet for this customer.</p>
  <% end %>
</div>
