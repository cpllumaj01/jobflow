<% content_for :title, @customer.name %>

<div class="flex flex-col items-start justify-between gap-6 sm:flex-row">
  <div class="min-w-0">
    <%= link_to "← Customers",
        customers_path,
        class: "text-sm font-medium text-slate-500 hover:text-slate-900 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 hover:underline underline-offset-4 py-2" %>

    <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">
      <%= @customer.name %>
    </h1>

    <% if @customer.contact_name.present? %>
      <p class="mt-2 text-slate-600">
        <%= @customer.contact_name %>
      </p>
    <% end %>
  </div>

  <%= link_to "Edit customer",
      edit_customer_path(@customer),
      class: "inline-block shrink-0 cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-center text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:border-slate-400 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
</div>

<div class="mt-8">
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
    <h2 class="text-lg font-semibold text-slate-950">
      Customer details
    </h2>

    <dl class="mt-6 grid gap-6 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-slate-500">Email</dt>
        <dd class="mt-1 text-sm text-slate-900">
          <%= @customer.email.presence || "Not provided" %>
        </dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-slate-500">Phone</dt>
        <dd class="mt-1 text-sm text-slate-900">
          <%= @customer.phone.presence || "Not provided" %>
        </dd>
      </div>

      <div class="sm:col-span-2">
        <dt class="text-sm font-medium text-slate-500">Address</dt>
        <dd class="mt-1 text-sm text-slate-900">
          <%= @customer.address.presence || "Not provided" %>
        </dd>
      </div>

      <div class="sm:col-span-2">
        <dt class="text-sm font-medium text-slate-500">Notes</dt>
        <dd class="mt-1 whitespace-pre-line text-sm text-slate-900">
          <%= @customer.notes.presence || "No notes" %>
        </dd>
      </div>
    </dl>

    <div class="mt-6 border-t border-slate-200 pt-6">
      <%= button_to "Delete customer",
          @customer,
          method: :delete,
          class: "inline-block cursor-pointer rounded-lg border border-red-200 bg-white px-4 py-2.5 text-center text-sm font-semibold text-red-700 transition-colors hover:border-red-300 hover:bg-red-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700" %>
    </div>
  </div>
</div>

<div class="mt-10">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-semibold text-slate-950">Jobs</h2>
      <p class="mt-1 text-sm text-slate-500">
        Work associated with this customer.
      </p>
    </div>

    <%= link_to "New job",
        new_job_path(customer_id: @customer.id),
        class: "inline-block shrink-0 cursor-pointer rounded-lg bg-slate-900 px-4 py-2.5 text-center text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
  </div>

  <div class="mt-5 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <% if @jobs.any? %>
      <div class="divide-y divide-slate-100">
        <% @jobs.each do |job| %>
          <div class="flex flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6">
            <div>
              <%= link_to job.name,
                  job,
                  class: "font-semibold text-slate-950 hover:text-slate-600 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 hover:underline underline-offset-4 py-2" %>

              <div class="mt-1">
                <span class="<%= status_badge_classes(job.status) %>">
                  <%= job.status.humanize %>
                </span>
              </div>
            </div>

            <%= link_to "View",
                job,
                class: "inline-block shrink-0 cursor-pointer rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-slate-400 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-6 py-10 text-center">
        <h3 class="font-semibold text-slate-950">No jobs yet</h3>
        <p class="mt-1 text-sm text-slate-500">
          Create a job for this customer to track work, estimates, and change orders.
        </p>
      </div>
    <% end %>
  </div>
</div>
