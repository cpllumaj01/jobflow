<li class="py-4">
  <p class="break-words text-sm font-medium text-slate-900"><%= activity_event_name(activity) %></p>
  <% metadata = activity_metadata(activity) %>
  <% if metadata.any? %>
    <dl class="mt-2 space-y-1 text-sm">
      <% metadata.each do |key, value| %>
        <div class="grid gap-x-3 sm:grid-cols-[minmax(0,10rem)_minmax(0,1fr)]">
          <dt class="min-w-0 break-words font-medium text-slate-600"><%= key.to_s.humanize(keep_id_suffix: true) %></dt>
          <dd class="min-w-0 whitespace-pre-wrap break-words text-slate-700"><%= activity_metadata_value(value) %></dd>
        </div>
      <% end %>
    </dl>
  <% end %>
  <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-slate-500">
    <% if activity.actor.present? %>
      <span class="break-words"><%= activity.actor.email_address %></span>
    <% end %>
    <time datetime="<%= activity.created_at.iso8601 %>"><%= activity.created_at.strftime("%b %-d, %Y at %-I:%M %p %Z") %></time>
  </div>
</li>
