<% content_for :title, "New estimate" %>

<div class="mx-auto max-w-4xl">
  <div class="mb-8">
    <%= link_to "← #{@job.name}",
        job_path(@job),
        class: "text-sm font-medium text-slate-500 hover:text-slate-900" %>

    <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">
      New estimate
    </h1>

    <p class="mt-2 text-slate-600">
      Build an estimate for <span class="font-medium text-slate-900"><%= @job.name %></span>.
    </p>
  </div>

  <%= render "form", estimate: @estimate, job: @job %>
</div>
