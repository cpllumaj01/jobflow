<% content_for :title, "Estimate" %>

<div class="mx-auto max-w-5xl">
  <div class="flex flex-col items-start justify-between gap-6 sm:flex-row">
    <div class="min-w-0">
      <%= link_to "← #{@job.name}",
          job_path(@job),
          class: "text-sm font-medium text-slate-500 hover:text-slate-900 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 hover:underline underline-offset-4 py-2" %>

      <div class="mt-3 flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-bold tracking-tight text-slate-950">
          Estimate
        </h1>

        <span class="<%= status_badge_classes(@estimate.status) %>">
          <%= @estimate.status.humanize %>
        </span>
      </div>

      <p class="mt-2 text-slate-600">
        <%= @job.name %>
      </p>
    </div>

    <div class="flex shrink-0 flex-wrap gap-3 sm:justify-end">
      <%= link_to "Download PDF",
          job_estimate_path(@job, format: :pdf),
          data: { turbo: false },
          class: "inline-block shrink-0 cursor-pointer rounded-lg bg-slate-900 px-4 py-2.5 text-center text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
      <% unless @estimate.status == "approved" %>
        <%= link_to "Edit estimate",
            edit_job_estimate_path(@job),
            class: "inline-block cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-center text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:border-slate-400 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
      <% end %>
    </div>
  </div>

  <% if @estimate.status == "approved" %>
    <div class="mt-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
      This estimate is approved and locked from editing. Move it to a non-approved status before making changes.
    </div>
  <% end %>

  <div class="mt-8 grid gap-6 lg:grid-cols-3">
    <div class="rounded-xl border border-slate-300 bg-white p-4 shadow-sm sm:p-6 lg:col-span-2">
      <h2 class="text-lg font-semibold text-slate-950">
        Details
      </h2>

      <dl class="mt-6 grid gap-6 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-slate-500">Expires</dt>
          <dd class="mt-1 text-sm text-slate-900">
            <%= @estimate.expires_on.present? ? @estimate.expires_on.to_fs(:long) : "No expiration date" %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-slate-500">Status</dt>
          <dd class="mt-1 text-sm text-slate-900">
            <%= @estimate.status.humanize %>
          </dd>
        </div>

        <div class="sm:col-span-2">
          <dt class="text-sm font-medium text-slate-500">Notes</dt>
          <dd class="mt-1 whitespace-pre-line text-sm text-slate-900">
            <%= @estimate.notes.presence || "No notes" %>
          </dd>
        </div>
      </dl>
    </div>

    <div class="rounded-xl border border-slate-300 bg-white p-4 shadow-sm sm:p-6">
      <h2 class="text-lg font-semibold text-slate-950">
        Status actions
      </h2>

      <div class="mt-4 space-y-3">
        <% if @estimate.status != "sent" %>
          <%= button_to "Mark as sent",
              mark_sent_job_estimate_path(@job),
              method: :patch,
              class: "w-full inline-block cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-center text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:border-slate-400 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
        <% end %>

        <% if @estimate.status == "sent" %>
          <%= button_to "Approve estimate",
              approve_job_estimate_path(@job),
              method: :patch,
              class: "w-full inline-block cursor-pointer rounded-lg bg-slate-900 px-4 py-2.5 text-center text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
        <% end %>

        <% if %w[sent approved].include?(@estimate.status) %>
          <%= button_to "Reject estimate",
              reject_job_estimate_path(@job),
              method: :patch,
              class: "w-full inline-block cursor-pointer rounded-lg border border-red-200 bg-white px-4 py-2.5 text-center text-sm font-semibold text-red-700 transition-colors hover:border-red-300 hover:bg-red-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="mt-8 overflow-hidden rounded-xl border border-slate-300 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-6 py-5">
      <h2 class="text-lg font-semibold text-slate-950">
        Line items
      </h2>
    </div>

    <% line_items_empty = @estimate.estimate_line_items.load.empty? %>
    <div class="overflow-x-auto" role="region" aria-label="Estimate line items" tabindex="0">
      <table class="w-full min-w-160 text-left text-sm">
        <thead class="<%= "hidden" if line_items_empty %> border-b border-slate-300 bg-slate-100 text-xs font-semibold uppercase tracking-wide text-slate-600">
          <tr>
            <th class="min-w-56 px-6 py-3 whitespace-nowrap">Description</th>
            <th class="px-6 py-3 whitespace-nowrap text-right">Quantity</th>
            <th class="px-6 py-3 whitespace-nowrap text-right">Unit price</th>
            <th class="px-6 py-3 whitespace-nowrap text-right">Line total</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-slate-200">
          <% if line_items_empty %>
            <tr>
              <td colspan="4" class="px-6 py-8 text-center">
                <p class="font-semibold text-slate-950">No line items yet</p>
                <p class="mt-1 text-sm text-slate-500">
                  <% if @estimate.status == "approved" %>
                    Mark the estimate as sent or rejected before adding line items.
                  <% else %>
                    Use Edit estimate to add work, quantities, and prices.
                  <% end %>
                </p>
              </td>
            </tr>
          <% end %>
          <% @estimate.estimate_line_items.each do |line_item| %>
            <tr>
              <td class="px-6 py-4 font-medium text-slate-950">
                <%= line_item.description %>
              </td>

              <td class="px-6 py-4 whitespace-nowrap text-right text-slate-600">
                <%= line_item.quantity %>
              </td>

              <td class="px-6 py-4 whitespace-nowrap text-right text-slate-600">
                <%= number_to_currency(line_item.unit_price) %>
              </td>

              <td class="px-6 py-4 whitespace-nowrap text-right font-medium text-slate-950">
                <%= number_to_currency(line_item.line_total) %>
              </td>
            </tr>
          <% end %>
        </tbody>

        <tfoot class="border-t border-slate-200 bg-slate-50">
          <tr>
            <td colspan="3" class="px-6 py-4 whitespace-nowrap text-right text-sm font-semibold text-slate-700">
              Estimate total
            </td>

            <td class="px-6 py-4 whitespace-nowrap text-right text-lg font-bold text-slate-950">
              <%= number_to_currency(@estimate.total) %>
            </td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</div>
