<%= form_with model: estimate,
    url: job_estimate_path(job),
    class: "space-y-8" do |form| %>

  <%= render "shared/form_errors", record: estimate, inline_fields: %w[expires_on notes estimate_line_items.description estimate_line_items.quantity estimate_line_items.unit_price] %>

  <div class="rounded-xl border border-slate-300 bg-white p-4 shadow-sm sm:p-6">
    <h2 class="text-lg font-semibold text-slate-950">
      Estimate details
    </h2>

    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      <div class="min-w-0">
        <%= form.label :expires_on,
            class: "block text-sm font-medium text-slate-700" %>

        <%= form.date_field :expires_on, **field_error_attributes(form, :expires_on),
            class: "mt-2 block min-w-0 w-full max-w-full appearance-none rounded-lg border border-slate-400 bg-white px-3 py-2.5 text-base sm:text-sm text-slate-950 shadow-sm focus:border-slate-500 transition-colors hover:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-500" %>
        <%= field_errors(form, :expires_on) %>
      </div>
    </div>

    <div class="mt-6">
      <%= form.label :notes,
          class: "block text-sm font-medium text-slate-700" %>

      <%= form.textarea :notes, **field_error_attributes(form, :notes),
          rows: 4,
          class: "mt-2 block min-w-0 w-full rounded-lg border border-slate-400 bg-white px-3 py-2.5 text-base sm:text-sm text-slate-950 shadow-sm focus:border-slate-500 transition-colors hover:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-500" %>
      <%= field_errors(form, :notes) %>
    </div>
  </div>

  <%= render "shared/line_items", form: form, association: :estimate_line_items, new_line_item: EstimateLineItem.new(quantity: nil) %>

  <div class="flex flex-wrap items-center gap-3">
    <%= form.submit class: "inline-block cursor-pointer rounded-lg bg-slate-900 px-4 py-2.5 text-center text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>

    <%= link_to "Cancel",
        estimate.persisted? ? job_estimate_path(job) : job_path(job),
        class: "text-sm font-medium text-slate-600 hover:text-slate-950 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 hover:underline underline-offset-4 py-2" %>
  </div>
<% end %>
