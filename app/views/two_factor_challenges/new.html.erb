<% content_for :title, "Verify sign-in | JobFlow" %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div class="mx-auto w-full max-w-md rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
  <h1 class="text-2xl font-bold tracking-tight text-slate-950">Verify your sign-in</h1>
  <p class="mt-2 text-sm text-slate-600">Enter a code from your authenticator app or an unused recovery code. This sign-in step expires after five minutes.</p>
  <%= form_with url: two_factor_challenge_path, data: { turbo: false }, class: "mt-6 space-y-5" do |form| %>
    <div>
      <%= form.label :verification_code, "Authenticator or recovery code", class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_field :verification_code, required: true, autofocus: true, autocomplete: "one-time-code", spellcheck: false, autocapitalize: "none", class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm shadow-sm focus:outline-2 focus:outline-slate-500" %>
    </div>
    <%= form.submit "Verify sign-in", class: "w-full cursor-pointer rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
  <% end %>
  <%= button_to "Cancel sign-in", two_factor_challenge_path, method: :delete, data: { turbo: false }, class: "mt-4 min-h-11 cursor-pointer text-sm font-semibold text-slate-700 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
</div>
