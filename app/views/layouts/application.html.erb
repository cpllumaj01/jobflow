<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "JobFlow" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="JobFlow">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/jobflow-icon.svg" type="image/svg+xml" sizes="any">
    <link rel="apple-touch-icon" href="/jobflow-icon.png" sizes="512x512">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white" data-controller="navigation"
        data-action="keydown.esc@window->navigation#escape focusout->navigation#dismiss resize@window->navigation#resize turbo:before-cache@document->navigation#close">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-2 px-4 py-4 sm:px-6">
        <%= link_to root_path, class: "text-xl font-bold tracking-tight text-slate-900 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" do %>
          JobFlow
        <% end %>

        <% if Current.user %>
          <button type="button" hidden data-navigation-target="toggle" data-action="navigation#toggle"
              aria-expanded="false" aria-controls="main-navigation"
              class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-lg border border-slate-300 px-3 text-sm font-semibold text-slate-700 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 md:hidden">
            <svg aria-hidden="true" focusable="false" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            Menu
          </button>
          <nav id="main-navigation" aria-label="Main navigation" data-navigation-target="panel"
              class="flex w-full flex-col items-start gap-2 text-sm font-medium md:flex md:w-auto md:flex-row md:items-center md:gap-6">
            <%= link_to "Dashboard", root_path, data: { navigation_target: "firstLink" },
                class: "text-slate-600 hover:text-slate-950 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 hover:underline underline-offset-4 inline-flex min-h-11 items-center py-2 md:min-h-0" %>

            <%= link_to "Customers", customers_path,
                class: "text-slate-600 hover:text-slate-950 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 hover:underline underline-offset-4 inline-flex min-h-11 items-center py-2 md:min-h-0" %>

            <%= link_to "Jobs", jobs_path,
                class: "text-slate-600 hover:text-slate-950 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 hover:underline underline-offset-4 inline-flex min-h-11 items-center py-2 md:min-h-0" %>

            <%= link_to "Account", account_path,
                class: "text-slate-600 hover:text-slate-950 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 hover:underline underline-offset-4 inline-flex min-h-11 items-center py-2 md:min-h-0" %>

            <%= button_to "Log out",
                session_path,
                method: :delete,
                class: "cursor-pointer text-slate-600 hover:text-slate-950 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 hover:underline underline-offset-4 inline-flex min-h-11 items-center py-2 md:min-h-0" %>
          </nav>
        <% end %>
      </div>
    </header>

    <main class="mx-auto w-full max-w-7xl wrap-anywhere px-4 py-6 sm:px-6 sm:py-10">
      <% if notice.present? %>
        <div class="mb-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
          <%= notice %>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
          <%= alert %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
