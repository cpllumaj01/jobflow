<% content_for :title, "Dashboard" %>

<div class="mb-6 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
  <div>
    <p class="text-sm font-medium text-slate-500">Business overview</p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-950">Dashboard</h1>
    <p class="mt-2 text-sm text-slate-600 sm:text-base">Your work, approvals, and contract value at a glance.</p>
  </div>
  <% if @total_jobs.positive? %>
    <%= link_to "New job", new_job_path,
        class: "inline-flex min-h-11 shrink-0 items-center justify-center rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
  <% end %>
</div>

<% if @total_jobs.zero? %>
  <section aria-labelledby="onboarding-title" class="mb-6 flex flex-col items-start justify-between gap-4 rounded-xl border border-blue-200 bg-blue-50 p-5 sm:flex-row sm:items-center sm:p-6">
    <div>
      <h2 id="onboarding-title" class="font-semibold text-slate-950">Get started with JobFlow</h2>
      <p class="mt-1 max-w-xl text-sm text-slate-600">
        <%= @total_customers.zero? ? "Add your first customer, then create a job to track estimates and changes in one place." : "Create your first job to start tracking work, estimates, and change orders." %>
      </p>
    </div>
    <%= link_to(@total_customers.zero? ? "Add first customer" : "Create first job", @total_customers.zero? ? new_customer_path : new_job_path,
        class: "inline-flex min-h-11 shrink-0 items-center justify-center rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900") %>
  </section>
<% end %>

<div class="grid gap-3 sm:grid-cols-3 sm:gap-4">
  <% [ [ "total_customers", "Total customers", @total_customers, customers_path, "View customers" ],
       [ "total_jobs", "Total jobs", @total_jobs, jobs_path, "View all jobs" ],
       [ "active_jobs", "Active jobs", @active_jobs, jobs_path(status: %w[approved in_progress]), "View active jobs" ] ].each do |id, label, count, path, action| %>
    <%= link_to path, class: "group flex min-w-0 items-center gap-4 rounded-xl border border-slate-300 bg-white px-5 py-4 shadow-sm transition hover:border-slate-400 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 sm:block" do %>
      <dl id="<%= id %>" class="flex min-w-0 flex-1 items-center justify-between gap-3 sm:block">
        <dt class="text-sm font-medium text-slate-600"><%= label %></dt>
        <dd class="text-3xl font-semibold tracking-tight text-slate-950 tabular-nums sm:mt-1"><%= number_with_delimiter(count) %></dd>
      </dl>
      <span class="flex items-center justify-between gap-2 text-xs font-medium text-slate-600 group-hover:text-slate-950 sm:mt-2">
        <span class="sr-only sm:not-sr-only"><%= action %></span><span aria-hidden="true">&rarr;</span>
      </span>
    <% end %>
  <% end %>
</div>

<section aria-labelledby="approvals-title" class="my-6 rounded-xl border border-slate-300 bg-slate-100 px-5 py-4 sm:px-6">
  <div class="grid items-center gap-4 sm:grid-cols-3 sm:gap-6">
    <div>
      <h2 id="approvals-title" class="text-sm font-semibold text-slate-950">Awaiting decisions</h2>
      <p class="mt-1 text-xs text-slate-600"><%= (@pending_estimates + @pending_change_orders).zero? ? "No approvals outstanding." : "Follow up on sent and pending work." %></p>
    </div>
    <dl id="pending_estimates" class="flex items-center justify-between gap-3 border-t border-slate-300 pt-3 sm:block sm:border-t-0 sm:border-l sm:pt-0 sm:pl-6">
      <dt class="text-sm text-slate-700">Pending estimates<span class="mt-0.5 block text-xs text-slate-600">Sent to customers</span></dt>
      <dd class="text-2xl font-semibold text-slate-950 tabular-nums sm:mt-1"><%= number_with_delimiter(@pending_estimates) %></dd>
    </dl>
    <dl id="pending_change_orders" class="flex items-center justify-between gap-3 border-t border-slate-300 pt-3 sm:block sm:border-t-0 sm:border-l sm:pt-0 sm:pl-6">
      <dt class="text-sm text-slate-700">Pending change orders<span class="mt-0.5 block text-xs text-slate-600">Awaiting approval</span></dt>
      <dd class="text-2xl font-semibold text-slate-950 tabular-nums sm:mt-1"><%= number_with_delimiter(@pending_change_orders) %></dd>
    </dl>
  </div>
</section>

<div class="grid items-start gap-6 lg:grid-cols-5">
  <section aria-labelledby="contract-title" class="min-w-0 overflow-hidden rounded-xl border border-slate-800 bg-white shadow-sm <%= @total_jobs.positive? ? 'lg:col-span-2' : 'lg:col-span-5 sm:grid sm:grid-cols-2 sm:items-center' %>">
    <div class="bg-slate-900 p-5 text-white sm:p-6">
      <h2 id="contract-title" class="text-base font-semibold">Contract overview</h2>
      <dl id="total_current_contract_value" class="mt-5">
        <dt class="text-sm text-slate-300">Total current contract value</dt>
        <dd class="mt-2 text-2xl font-semibold tracking-tight tabular-nums sm:text-3xl xl:text-4xl"><%= number_to_currency(@total_current_contract_value) %></dd>
      </dl>
      <p class="mt-3 text-xs text-slate-300">Approved work across all jobs. Pending work is excluded.</p>
    </div>
    <% if @total_current_contract_value.positive? %>
      <figure id="contract_breakdown" aria-labelledby="contract-breakdown-title" class="p-5 sm:p-6">
        <figcaption id="contract-breakdown-title" class="text-sm font-semibold text-slate-950">Where the value comes from</figcaption>
        <div aria-hidden="true" class="mt-4 flex h-3 overflow-hidden rounded-full bg-slate-100">
          <span class="h-full bg-blue-600" style="width: <%= dashboard_percentage(@approved_estimate_value, @total_current_contract_value) %>%"></span>
          <span class="h-full bg-teal-500" style="width: <%= dashboard_percentage(@approved_change_order_value, @total_current_contract_value) %>%"></span>
        </div>
        <dl class="mt-5 space-y-4 text-sm">
          <% [ [ "approved_estimate_value", "Approved estimates", @approved_estimate_value, "bg-blue-600" ],
               [ "approved_change_order_value", "Approved change orders", @approved_change_order_value, "bg-teal-500" ] ].each do |id, label, value, color| %>
            <div id="<%= id %>">
              <dt class="flex items-center gap-2 text-slate-600"><span aria-hidden="true" class="size-2 shrink-0 rounded-full <%= color %>"></span><%= label %></dt>
              <dd class="mt-1 pl-4">
                <span class="font-semibold text-slate-950 tabular-nums"><%= number_to_currency(value) %></span>
              </dd>
            </div>
          <% end %>
        </dl>
      </figure>
    <% else %>
      <div class="p-5 sm:p-6">
        <h3 class="text-sm font-semibold text-slate-950">No approved contract value yet</h3>
        <p class="mt-1 text-sm text-slate-600">Approved estimates and change orders will build your contract value here.</p>
      </div>
    <% end %>
  </section>

  <% if @total_jobs.positive? %>
    <section id="jobs_by_status" aria-labelledby="job-status-title" aria-describedby="job-status-description" class="min-w-0 rounded-xl border border-slate-300 bg-white p-5 shadow-sm sm:p-6 lg:order-first lg:col-span-3">
      <div class="flex items-baseline justify-between gap-3">
        <h2 id="job-status-title" class="text-base font-semibold text-slate-950">Jobs by status</h2>
        <p class="shrink-0 text-sm text-slate-500"><%= pluralize(@total_jobs, "job") %></p>
      </div>
      <p id="job-status-description" class="mt-1 text-sm text-slate-600">From first quote to finished work. Select a status to view jobs.</p>
      <ul class="mt-5 space-y-1">
        <% Job::STATUSES.each do |status| %>
          <% count = @jobs_by_status.fetch(status, 0) %>
          <li>
            <%= link_to jobs_path(status: [ status ]), aria: { label: "#{status.humanize}: #{pluralize(count, 'job')}" },
                class: "group flex min-h-11 items-center gap-3 rounded-lg px-2 py-2 transition-colors hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" do %>
              <span class="w-22 shrink-0 text-sm font-medium text-slate-700 group-hover:text-slate-950"><%= status.humanize %></span>
              <span aria-hidden="true" class="h-2 min-w-0 flex-1 overflow-hidden rounded-full bg-slate-100">
                <span class="block h-full rounded-full bg-slate-600" style="width: <%= dashboard_percentage(count, @total_jobs) %>%"></span>
              </span>
              <span class="min-w-6 shrink-0 text-right text-sm font-semibold text-slate-950 tabular-nums"><%= number_with_delimiter(count) %></span>
              <span aria-hidden="true" class="text-slate-400 group-hover:text-slate-700">&rarr;</span>
            <% end %>
          </li>
        <% end %>
      </ul>
      <p class="mt-4 border-t border-slate-200 pt-4 text-xs text-slate-600">Active jobs include approved work and work in progress.</p>
    </section>
  <% end %>
</div>
