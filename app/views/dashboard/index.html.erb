<% content_for :title, "Dashboard" %>

<div class="mb-8">
  <p class="text-sm font-medium text-slate-500">Overview</p>
  <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-950">
    Dashboard
  </h1>
  <p class="mt-2 text-slate-600">
    Manage your customers, jobs, estimates, and change orders.
  </p>
</div>

<dl class="mb-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <div id="total_customers" class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <dt class="text-sm font-medium text-slate-500">Total customers</dt>
    <dd class="mt-2 text-2xl font-bold tracking-tight text-slate-950"><%= @total_customers %></dd>
  </div>
  <div id="total_jobs" class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <dt class="text-sm font-medium text-slate-500">Total jobs</dt>
    <dd class="mt-2 text-2xl font-bold tracking-tight text-slate-950"><%= @total_jobs %></dd>
  </div>
  <div id="active_jobs" class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <dt class="text-sm font-medium text-slate-500">Active jobs</dt>
    <dd class="mt-2 text-2xl font-bold tracking-tight text-slate-950"><%= @active_jobs %></dd>
  </div>
  <div id="pending_estimates" class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <dt class="text-sm font-medium text-slate-500">Pending estimates</dt>
    <dd class="mt-2 text-2xl font-bold tracking-tight text-slate-950"><%= @pending_estimates %></dd>
  </div>
  <div id="pending_change_orders" class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <dt class="text-sm font-medium text-slate-500">Pending change orders</dt>
    <dd class="mt-2 text-2xl font-bold tracking-tight text-slate-950"><%= @pending_change_orders %></dd>
  </div>
  <div id="total_current_contract_value" class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <dt class="text-sm font-medium text-slate-500">Total current contract value</dt>
    <dd class="mt-2 text-2xl font-bold tracking-tight text-slate-950"><%= number_to_currency(@total_current_contract_value) %></dd>
  </div>
</dl>

<div class="grid gap-4 sm:grid-cols-2">
  <%= link_to customers_path,
      class: "cursor-pointer rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-slate-300 hover:bg-slate-50 hover:shadow focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" do %>
    <h2 class="font-semibold text-slate-950">Customers</h2>
    <p class="mt-1 text-sm text-slate-500">
      View and manage your customer records.
    </p>
  <% end %>

  <%= link_to jobs_path,
      class: "cursor-pointer rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-slate-300 hover:bg-slate-50 hover:shadow focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" do %>
    <h2 class="font-semibold text-slate-950">Jobs</h2>
    <p class="mt-1 text-sm text-slate-500">
      Track active work, estimates, and change orders.
    </p>
  <% end %>
</div>
