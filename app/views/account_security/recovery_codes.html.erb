<% content_for :title, "Two-factor authentication enabled | JobFlow" %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div class="mx-auto w-full max-w-2xl space-y-6">
  <div class="rounded-xl border border-slate-300 bg-white p-6 shadow-sm sm:p-8">
    <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-800 ring-1 ring-emerald-600/20 ring-inset">Enabled</span>
    <h1 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">Two-factor authentication is enabled</h1>
    <p class="mt-2 text-sm text-slate-600">Your account is protected with an authenticator app.</p>
    <%= link_to "Continue to JobFlow", root_path, class: "mt-5 inline-flex min-h-11 items-center justify-center rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>

    <section aria-labelledby="recovery-codes-heading" data-controller="recovery-codes" data-action="pagehide@window->recovery-codes#clear turbo:before-cache@document->recovery-codes#clear" class="mt-6 border-t border-slate-200 pt-6">
      <h2 id="recovery-codes-heading" class="text-base font-semibold text-slate-950">Recovery codes <span class="font-normal text-slate-500">(optional)</span></h2>
      <p class="mt-2 text-sm text-slate-600">Save these in case you lose access to your authenticator. Each code can be used once.</p>
      <ul aria-label="Recovery codes" class="-mx-3 mt-4 grid gap-2 rounded-lg bg-slate-100 p-2 font-mono text-xs sm:mx-0 sm:p-4 md:grid-cols-2">
        <% @recovery_codes.each do |code| %>
          <li data-recovery-codes-target="code" class="break-all"><%= code %></li>
        <% end %>
      </ul>
      <p class="mt-3 text-sm text-slate-600">Shown only once, previous codes are invalid. Skipped codes can't be retrieved. Generate replacements in Account → Security while signed in. Without saved codes, losing your authenticator could lock you out.</p>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <button type="button" data-action="recovery-codes#copy" class="min-h-11 cursor-pointer rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900">Copy</button>
        <button type="button" data-action="recovery-codes#download" class="min-h-11 cursor-pointer rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900">Download</button>
        <%= link_to "Skip for now", account_path, class: "inline-flex min-h-11 items-center px-1 text-sm font-semibold text-slate-700 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
      </div>
      <p role="status" data-recovery-codes-target="status" class="mt-2 text-sm text-slate-600"></p>
    </section>
  </div>
</div>
