<% content_for :title, "Sign in | JobFlow" %>

<div class="mx-auto w-full max-w-md">
  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <h1 class="text-2xl font-bold tracking-tight text-slate-950">Sign in</h1>
    <p class="mt-2 text-sm text-slate-600">Welcome back. Sign in to manage your jobs.</p>

    <%= form_with url: session_url, class: "mt-6 space-y-5" do |form| %>
      <div>
        <%= form.label :email_address, "Email address", class: "block text-sm font-medium text-slate-700" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm focus:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-500 transition-colors hover:border-slate-400" %>
      </div>
      <div>
        <%= form.label :password, "Password", class: "block text-sm font-medium text-slate-700" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm focus:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-500 transition-colors hover:border-slate-400" %>
      </div>

      <%= form.submit "Sign in", class: "w-full inline-block cursor-pointer rounded-lg bg-slate-900 px-4 py-2.5 text-center text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
    <% end %>
  </div>

  <div class="mt-6 text-center text-sm text-slate-600">
    <p><%= link_to "Forgot password?", new_password_path, class: "font-semibold text-slate-700 underline underline-offset-4 hover:text-slate-950 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 py-2" %></p>
    <p class="mt-3">New to JobFlow? <%= link_to "Create account", sign_up_path, class: "font-semibold text-slate-700 underline underline-offset-4 hover:text-slate-950 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 py-2" %></p>
  </div>
</div>
