<% content_for :title, @job.name %>

<div class="mx-auto max-w-6xl">
  <div class="flex flex-col items-start justify-between gap-6 sm:flex-row">
    <div class="min-w-0">
      <%= link_to "← Jobs",
          jobs_path,
          class: "text-sm font-medium text-slate-500 hover:text-slate-900 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 hover:underline underline-offset-4 py-2" %>

      <div class="mt-3 flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-bold tracking-tight text-slate-950">
          <%= @job.name %>
        </h1>

        <span class="<%= status_badge_classes(@job.status) %>">
          <%= @job.status.humanize %>
        </span>
      </div>

      <p class="mt-2 text-slate-600">
        <%= link_to @job.customer.name,
            customer_path(@job.customer),
            class: "font-medium text-slate-700 hover:text-slate-950 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 hover:underline underline-offset-4 py-2" %>
      </p>
    </div>

    <%= link_to "Edit job",
        edit_job_path(@job),
        class: "inline-block shrink-0 cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-center text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:border-slate-400 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
  </div>

  <section class="mt-8 rounded-xl border border-slate-300 bg-white p-4 shadow-sm sm:p-6" aria-labelledby="job-status-heading">
    <h2 id="job-status-heading" class="text-lg font-semibold text-slate-950">Job status</h2>
    <p id="job-status-help" class="mt-2 text-sm text-slate-600">
      <% if @job.status == "completed" %>
        Choose another status to reopen this job. Its previous completion stays in Activity history.
      <% else %>
        Completing the job records the current date and time automatically.
      <% end %>
    </p>
    <div class="mt-4 flex flex-wrap items-end gap-3">
      <%= form_with model: @job, url: update_status_job_path(@job), method: :patch,
          class: "contents" do |form| %>
        <div class="w-full min-w-0 sm:w-56">
          <%= form.label :status, "New status", class: "block text-sm font-medium text-slate-700" %>
          <%= form.select :status, Job::STATUSES.map { |status| [status.humanize, status] }, {},
              aria: { describedby: "job-status-help" },
              class: "mt-2 block min-h-11 min-w-0 w-full cursor-pointer rounded-lg border border-slate-400 bg-white px-3 py-2.5 text-base text-slate-950 shadow-sm transition-colors hover:border-slate-500 focus:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-500 sm:text-sm" %>
        </div>
        <%= form.submit "Update status", class: "min-h-11 cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:border-slate-400 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
      <% end %>
      <% unless %w[completed cancelled].include?(@job.status) %>
        <%= button_to "Complete job", update_status_job_path(@job), method: :patch,
            params: { job: { status: "completed" } },
            class: "min-h-11 cursor-pointer rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
      <% end %>
    </div>
  </section>

  <div class="mt-8 grid gap-4 md:grid-cols-3">
    <div class="rounded-xl border border-slate-300 bg-white p-5 shadow-sm">
      <p class="text-sm font-medium text-slate-500">
        Original estimate
      </p>

      <p class="mt-2 text-2xl font-bold tracking-tight text-slate-950">
        <%= number_to_currency(@job.original_estimate_value) %>
      </p>

      <p class="mt-1 text-xs text-slate-500">
        Approved estimate value
      </p>
    </div>

    <div class="rounded-xl border border-slate-300 bg-white p-5 shadow-sm">
      <p class="text-sm font-medium text-slate-500">
        Approved changes
      </p>

      <p class="mt-2 text-2xl font-bold tracking-tight text-slate-950">
        <%= number_to_currency(@job.approved_change_order_total) %>
      </p>

      <p class="mt-1 text-xs text-slate-500">
        Approved change orders
      </p>
    </div>

    <div class="rounded-xl border border-slate-300 bg-slate-900 p-5 shadow-sm">
      <p class="text-sm font-medium text-slate-300">
        Current contract value
      </p>

      <p class="mt-2 text-2xl font-bold tracking-tight text-white">
        <%= number_to_currency(@job.current_contract_value) %>
      </p>

      <p class="mt-1 text-xs text-slate-400">
        Estimate plus approved changes
      </p>
    </div>
  </div>

  <div class="mt-8">
    <div class="rounded-xl border border-slate-300 bg-white p-4 shadow-sm sm:p-6">
      <h2 class="text-lg font-semibold text-slate-950">
        Job details
      </h2>

      <dl class="mt-6 grid gap-6 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-slate-500">Customer</dt>
          <dd class="mt-1 text-sm text-slate-900">
            <%= link_to @job.customer.name,
                customer_path(@job.customer),
                class: "font-medium hover:text-slate-600 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 hover:underline underline-offset-4 py-2" %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-slate-500">Status</dt>
          <dd class="mt-1 text-sm text-slate-900">
            <%= @job.status.humanize %>
          </dd>
        </div>

        <div class="sm:col-span-2">
          <dt class="text-sm font-medium text-slate-500">Address</dt>
          <dd class="mt-1 text-sm text-slate-900">
            <%= @job.address.presence || "Not provided" %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-slate-500">Start date</dt>
          <dd class="mt-1 text-sm text-slate-900">
            <%= @job.start_date.present? ? @job.start_date.to_fs(:long) : "Not scheduled" %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-slate-500">
            Estimated completion
          </dt>
          <dd class="mt-1 text-sm text-slate-900">
            <%= @job.estimated_completion_date.present? ? @job.estimated_completion_date.to_fs(:long) : "Not scheduled" %>
          </dd>
        </div>

        <% if @job.status == "completed" && @job.completed_at.present? %>
          <div>
            <dt class="text-sm font-medium text-slate-500">Completed</dt>
            <dd class="mt-1 text-sm text-slate-900">
              <%= @job.completed_at.to_fs(:long) %>
            </dd>
          </div>
        <% end %>

        <div class="sm:col-span-2">
          <dt class="text-sm font-medium text-slate-500">Description</dt>
          <dd class="mt-1 whitespace-pre-line text-sm text-slate-900">
            <%= @job.description.presence || "No description" %>
          </dd>
        </div>
      </dl>

      <div class="mt-6 border-t border-slate-200 pt-6">
        <%= button_to "Delete job",
            @job,
            method: :delete,
            class: "inline-block cursor-pointer rounded-lg border border-red-200 bg-white px-4 py-2.5 text-center text-sm font-semibold text-red-700 transition-colors hover:border-red-300 hover:bg-red-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700" %>
      </div>
    </div>
  </div>

  <section class="mt-8 rounded-xl border border-slate-300 bg-white p-4 shadow-sm sm:p-6" aria-labelledby="attachments-heading">
    <h2 id="attachments-heading" class="text-lg font-semibold text-slate-950">Attachments</h2>

    <% if @attachment_errors.present? %>
      <div role="alert" class="mt-4 text-sm text-red-600">
        <% @attachment_errors.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <% if @job.files.attached? %>
      <ul class="mt-4 divide-y divide-slate-200">
        <% @job.files.includes(:blob).each do |file| %>
          <li class="flex flex-wrap items-center justify-between gap-4 py-3">
            <div class="min-w-0">
              <%= link_to file.filename.to_s, job_attachment_path(@job, file),
                  class: "break-words text-sm font-semibold text-slate-700 hover:text-slate-950 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 hover:underline underline-offset-4 py-2" %>
              <p class="mt-1 text-xs text-slate-500"><%= number_to_human_size(file.byte_size) %> · <%= file.content_type %></p>
            </div>
            <%= button_to "Remove", job_attachment_path(@job, file), method: :delete,
                class: "inline-block cursor-pointer rounded-lg border border-red-200 bg-white px-4 py-2.5 text-center text-sm font-semibold text-red-700 transition-colors hover:border-red-300 hover:bg-red-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700",
                form: { data: { turbo: false } } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-sm text-slate-500">No attachments yet. Upload plans, photos, or documents using the form below.</p>
    <% end %>

    <%= form_with scope: :job, url: job_attachments_path(@job), multipart: true,
        data: { turbo: false }, class: "mt-6 space-y-3" do |form| %>
      <%= form.label :files, "Choose files", class: "block text-sm font-medium text-slate-700" %>
      <%= form.file_field :files, multiple: true, required: true,
          class: "block w-full cursor-pointer rounded-lg border border-slate-400 bg-white p-2 text-sm text-slate-700 transition-colors hover:border-slate-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 file:mr-4 file:cursor-pointer file:rounded-lg file:border-0 file:bg-slate-100 file:px-4 file:py-2.5 file:text-sm file:font-semibold file:text-slate-700 file:transition-colors file:hover:bg-slate-200", aria: { describedby: "file-size-limit" } %>
      <p id="file-size-limit" class="text-xs text-slate-500">Maximum 20 MB per file. Select one or more files to upload.</p>
      <%= form.submit "Upload files", class: "inline-block cursor-pointer rounded-lg bg-slate-900 px-4 py-2.5 text-center text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
    <% end %>
  </section>

  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    <div class="rounded-xl border border-slate-300 bg-white p-4 shadow-sm sm:p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="text-lg font-semibold text-slate-950">
            Estimate
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            Original pricing for this job.
          </p>
        </div>

        <% if @job.estimate.present? %>
          <span class="<%= status_badge_classes(@job.estimate.status) %>">
            <%= @job.estimate.status.humanize %>
          </span>
        <% end %>
      </div>

      <% if @job.estimate.present? %>
        <div class="mt-6">
          <p class="text-sm text-slate-500">Estimate total</p>

          <p class="mt-1 text-xl font-semibold text-slate-950">
            <%= number_to_currency(@job.estimate.total) %>
          </p>
        </div>

        <%= link_to "View estimate →",
            job_estimate_path(@job),
            class: "mt-6 inline-block cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-center text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:border-slate-400 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
      <% else %>
        <div class="mt-6">
          <p class="text-sm text-slate-500">
            No estimate yet. Create one to outline the work and pricing for this job.
          </p>

          <%= link_to "Create estimate",
              new_job_estimate_path(@job),
              class: "mt-4 inline-block cursor-pointer rounded-lg bg-slate-900 px-4 py-2.5 text-center text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
        </div>
      <% end %>
    </div>

    <div class="rounded-xl border border-slate-300 bg-white p-4 shadow-sm sm:p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="text-lg font-semibold text-slate-950">
            Change orders
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            Additional or revised work.
          </p>
        </div>

        <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">
          <%= @job.change_orders.count %>
        </span>
      </div>

      <div class="mt-6">
        <p class="text-sm text-slate-500">
          Approved changes
        </p>

        <p class="mt-1 text-xl font-semibold text-slate-950">
          <%= number_to_currency(@job.approved_change_order_total) %>
        </p>
      </div>

      <%= link_to "View change orders →",
          job_change_orders_path(@job),
          class: "mt-6 inline-block cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-center text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:border-slate-400 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
    </div>
  </div>
  <section class="mt-8 rounded-xl border border-slate-300 bg-white p-4 shadow-sm sm:p-6" aria-labelledby="activity-heading">
    <h2 id="activity-heading" class="text-lg font-semibold text-slate-950">Activity</h2>

    <% activities = @job.activities.newest_first.includes(:actor).to_a %>
    <% if activities.any? %>
      <ol class="mt-4 divide-y divide-slate-200">
        <%= render partial: "activities/activity", collection: activities %>
      </ol>
    <% else %>
      <p class="mt-4 text-sm text-slate-500">No activity yet. Status changes, estimates, change orders, and attachments will appear here.</p>
    <% end %>
  </section>
</div>
