<% content_for :title, "Jobs" %>
<%# After frame pagination, Back can restore page 3's results at page 1's URL from a cached snapshot. %>
<% turbo_exempts_page_from_cache %>

<div class="flex flex-col items-start justify-between gap-4 sm:flex-row">
  <div class="min-w-0">
    <p class="text-sm font-medium text-slate-500">Work</p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-950">
      Jobs
    </h1>
    <p class="mt-2 text-slate-600">
      Manage your current and upcoming work.
    </p>
  </div>

  <%= link_to "New job",
      new_job_path,
      class: "inline-block shrink-0 cursor-pointer rounded-lg bg-slate-900 px-4 py-2.5 text-center text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
</div>

<%= form_with url: jobs_path, method: :get,
    data: { controller: "job-filters", action: "submit->job-filters#cancel", turbo_frame: "jobs_results", turbo_action: "replace" },
    class: "mt-8 flex flex-wrap items-end gap-3 sm:gap-4" do |form| %>
  <div class="min-w-0 basis-full sm:min-w-64 sm:flex-1">
    <%= form.label :q, "Search jobs", class: "block text-sm font-medium text-slate-700" %>
    <%= form.search_field :q, value: @query, placeholder: "Job name, address, or customer",
        data: { action: "input->job-filters#search" },
        class: "mt-1 block min-w-0 w-full rounded-lg border border-slate-400 bg-white px-3 py-2.5 text-base sm:text-sm text-slate-900 shadow-sm transition-colors hover:border-slate-500 focus:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-500" %>
  </div>

  <div class="w-full sm:w-auto">
    <%= form.label :status, "Status", class: "block text-sm font-medium text-slate-700" %>
    <% status_options = Job::STATUSES.map { |status| [status.humanize, status] } %>
    <% status_options << ["Unknown status: #{@status}", @status] if @status.present? && !Job::STATUSES.include?(@status) %>
    <%= form.select :status, status_options, { include_blank: "All statuses", selected: @status },
        data: { action: "change->job-filters#submit" },
        class: "mt-1 block min-w-0 w-full rounded-lg border border-slate-400 bg-white px-3 py-2.5 text-base sm:text-sm text-slate-900 shadow-sm transition-colors hover:border-slate-500 focus:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-500 cursor-pointer" %>
  </div>

  <div class="flex w-full items-center gap-3 sm:contents">
    <%= form.submit "Filter jobs", class: "inline-block min-h-11 cursor-pointer rounded-lg bg-slate-900 px-4 py-2.5 text-center text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 sm:min-h-0" %>
    <%= link_to "Reset filters", jobs_path, data: { action: "click->job-filters#cancel" }, class: "inline-flex min-h-11 items-center px-2 py-2 text-sm font-medium text-slate-600 hover:text-slate-950 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 hover:underline underline-offset-4 sm:min-h-0" %>
  </div>
<% end %>

<%= turbo_frame_tag "jobs_results", target: "_top", data: { turbo_action: "replace" } do %>
  <div class="mt-8 overflow-hidden rounded-xl border border-slate-300 bg-white shadow-sm">
    <% if @jobs.any? %>
      <ul aria-label="Jobs" class="divide-y divide-slate-200 md:hidden">
        <% @jobs.each do |job| %>
          <li class="px-4 py-5">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <h2 class="text-base font-semibold text-slate-950"><%= job.name %></h2>
                <% if job.address.present? %>
                  <p class="mt-1 text-sm text-slate-600"><%= job.address %></p>
                <% end %>
              </div>
              <%= link_to "View", job_path(job), aria: { label: "View #{job.name}" },
                  class: "inline-flex min-h-11 shrink-0 cursor-pointer items-center rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-slate-400 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
            </div>
            <div class="mt-4 flex items-start justify-between gap-3">
              <dl class="min-w-0 flex-1 text-sm">
                <dt class="font-medium text-slate-600">Customer</dt>
                <dd class="mt-1 text-slate-900"><%= job.customer.name %></dd>
              </dl>
              <span class="<%= status_badge_classes(job.status) %>"><%= job.status.humanize %></span>
            </div>
          </li>
        <% end %>
      </ul>
      <div class="hidden overflow-x-auto md:block" role="region" aria-label="Jobs" tabindex="0">
        <table class="w-full min-w-160 text-left text-sm">
          <thead class="border-b border-slate-300 bg-slate-100 text-xs font-semibold uppercase tracking-wide text-slate-600">
            <tr>
              <th class="min-w-48 px-6 py-3 whitespace-nowrap">Job</th>
              <th class="min-w-48 px-6 py-3 whitespace-nowrap">Customer</th>
              <th class="px-6 py-3 whitespace-nowrap">Status</th>
              <th class="px-6 py-3 whitespace-nowrap text-right"></th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-200">
            <% @jobs.each do |job| %>
              <tr class="hover:bg-slate-50">
                <td class="px-6 py-4">
                  <div class="font-medium text-slate-950">
                    <%= job.name %>
                  </div>

                  <% if job.address.present? %>
                    <div class="mt-1 text-sm text-slate-500">
                      <%= job.address %>
                    </div>
                  <% end %>
                </td>

                <td class="px-6 py-4 text-slate-600">
                  <%= job.customer.name %>
                </td>

                <td class="px-6 py-4">
                  <span class="<%= status_badge_classes(job.status) %>">
                    <%= job.status.humanize %>
                  </span>
                </td>

                <td class="px-6 py-4 whitespace-nowrap text-right">
                  <%= link_to "View",
                      job_path(job),
                      class: "inline-block cursor-pointer rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-slate-400 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% elsif @query.present? || @status.present? %>
      <div class="px-6 py-12 text-center">
        <h2 class="font-semibold text-slate-950">No jobs match your filters</h2>
        <p class="mt-1 text-sm text-slate-500">Try a different search or reset the filters.</p>
      </div>
    <% else %>
      <div class="px-6 py-12 text-center">
        <h2 class="font-semibold text-slate-950">No jobs yet</h2>
        <p class="mt-1 text-sm text-slate-500">
          Create your first job to start tracking work.
        </p>
      </div>
    <% end %>
  </div>
  <%= render "shared/pagination", filters: { q: @query.presence, status: @status.presence }.compact, frame: "jobs_results" %>
<% end %>
