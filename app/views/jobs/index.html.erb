<% content_for :title, "Jobs" %>

<div class="flex items-start justify-between gap-4">
  <div>
    <p class="text-sm font-medium text-slate-500">Work</p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-950">
      Jobs
    </h1>
    <p class="mt-2 text-slate-600">
      Manage your current and upcoming work.
    </p>
  </div>

  <%= link_to "New job",
      new_job_path,
      class: "rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-700" %>
</div>

<div class="mt-8 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <% if @jobs.any? %>
    <table class="w-full text-left text-sm">
      <thead class="border-b border-slate-200 bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500">
        <tr>
          <th class="px-6 py-3">Job</th>
          <th class="px-6 py-3">Customer</th>
          <th class="px-6 py-3">Status</th>
          <th class="px-6 py-3 text-right"></th>
        </tr>
      </thead>

      <tbody class="divide-y divide-slate-100">
        <% @jobs.each do |job| %>
          <tr class="hover:bg-slate-50">
            <td class="px-6 py-4">
              <div class="font-medium text-slate-950">
                <%= job.name %>
              </div>

              <% if job.address.present? %>
                <div class="mt-1 text-sm text-slate-500">
                  <%= job.address %>
                </div>
              <% end %>
            </td>

            <td class="px-6 py-4 text-slate-600">
              <%= job.customer.name %>
            </td>

            <td class="px-6 py-4">
              <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">
                <%= job.status.humanize %>
              </span>
            </td>

            <td class="px-6 py-4 text-right">
              <%= link_to "View",
                  job_path(job),
                  class: "font-medium text-slate-700 hover:text-slate-950" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="px-6 py-12 text-center">
      <h2 class="font-semibold text-slate-950">No jobs yet</h2>
      <p class="mt-1 text-sm text-slate-500">
        Create your first job to start tracking work.
      </p>

      <%= link_to "Create a job",
          new_job_path,
          class: "mt-4 inline-block rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-700" %>
    </div>
  <% end %>
</div>
