<% content_for :title, "Jobs" %>
<%# After frame pagination, Back can restore page 3's results at page 1's URL from a cached snapshot. %>
<% turbo_exempts_page_from_cache %>

<div class="flex flex-col items-start justify-between gap-4 sm:flex-row">
  <div class="min-w-0">
    <p class="text-sm font-medium text-slate-500">Work</p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-950">
      Jobs
    </h1>
    <p class="mt-2 text-slate-600">
      Manage your current and upcoming work.
    </p>
  </div>

  <%= link_to "New job",
      new_job_path,
      class: "inline-block shrink-0 cursor-pointer rounded-lg bg-slate-900 px-4 py-2.5 text-center text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
</div>

<%= form_with url: jobs_path, method: :get,
    data: { controller: "job-filters", action: "submit->job-filters#cancel click@window->job-filters#dismiss resize@window->job-filters#positionDropdown", turbo_frame: "jobs_results", turbo_action: "replace" },
    class: "mt-8 flex flex-wrap items-end gap-3 sm:gap-4" do |form| %>
  <div class="min-w-0 basis-full sm:min-w-64 sm:flex-1">
    <%= form.label :q, "Search jobs", class: "block text-sm font-medium text-slate-700" %>
    <%= form.search_field :q, value: @query, placeholder: "Job name, address, or customer",
        data: { action: "input->job-filters#search" },
        class: "mt-1 block min-h-11 min-w-0 w-full rounded-lg border border-slate-400 bg-white px-3 py-2.5 text-base sm:text-sm text-slate-900 shadow-sm transition-colors hover:border-slate-500 focus:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-500" %>
  </div>

  <details data-job-filters-target="dropdown" data-action="keydown.esc->job-filters#escape focusout->job-filters#dismissFocus toggle->job-filters#positionDropdown"
      class="relative min-w-40 flex-1 sm:w-56 sm:flex-none">
    <summary data-job-filters-target="toggle" class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-2 rounded-lg border border-slate-400 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm transition-colors hover:border-slate-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-500 [&::-webkit-details-marker]:hidden">
      <span class="sr-only">Statuses: </span>
      <span data-job-filters-target="selection" aria-live="polite" class="min-w-0 truncate"><%= @statuses.empty? ? "All statuses" : @statuses.one? ? @statuses.first.humanize : "#{@statuses.size} statuses selected" %></span>
      <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4 shrink-0"><path fill-rule="evenodd" d="M5.22 7.22a.75.75 0 0 1 1.06 0L10 10.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 8.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
    </summary>
    <div data-job-filters-target="panel" class="absolute inset-x-0 top-full z-10 my-2 max-h-80 overflow-y-auto rounded-lg border border-slate-300 bg-white p-2 shadow-lg">
      <fieldset>
        <legend class="sr-only">Statuses</legend>
        <% (Job::STATUSES + (@statuses - Job::STATUSES)).each_with_index do |status, index| %>
          <label for="job_filter_status_<%= index %>" class="flex min-h-11 cursor-pointer items-center gap-3 rounded-md px-2 py-2 text-sm text-slate-700 hover:bg-slate-100 has-checked:font-medium has-checked:text-slate-950">
            <%= check_box_tag "status[]", status, @statuses.include?(status), id: "job_filter_status_#{index}",
                data: { job_filters_target: "status", action: "change->job-filters#changeStatuses" },
                class: "size-4 shrink-0 cursor-pointer accent-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
            <span class="min-w-0 break-words"><%= Job::STATUSES.include?(status) ? status.humanize : "Unknown status: #{status}" %></span>
          </label>
        <% end %>
      </fieldset>
    </div>
  </details>

  <%= form.submit "Filter jobs", data: { job_filters_target: "manualSubmit" }, class: "min-h-11 cursor-pointer rounded-lg bg-slate-900 px-4 py-2.5 text-center text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
  <%= link_to "Reset filters", jobs_path, data: { action: "click->job-filters#cancel" }, class: "inline-flex min-h-11 shrink-0 items-center py-2 text-sm font-medium text-slate-600 hover:text-slate-950 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 hover:underline underline-offset-4 sm:px-2" %>

<% end %>

<%= turbo_frame_tag "jobs_results", target: "_top", data: { turbo_action: "replace" } do %>
  <div class="mt-8 overflow-hidden rounded-xl border border-slate-300 bg-white shadow-sm">
    <% if @jobs.any? %>
      <ul aria-label="Jobs" class="divide-y divide-slate-200 md:hidden">
        <% @jobs.each do |job| %>
          <li class="px-4 py-5">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <h2 class="text-base font-semibold text-slate-950"><%= job.name %></h2>
                <% if job.address.present? %>
                  <p class="mt-1 text-sm text-slate-600"><%= job.address %></p>
                <% end %>
              </div>
              <%= link_to "View", job_path(job), aria: { label: "View #{job.name}" },
                  class: "inline-flex min-h-11 shrink-0 cursor-pointer items-center rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-slate-400 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
            </div>
            <div class="mt-4 flex items-start justify-between gap-3">
              <dl class="min-w-0 flex-1 text-sm">
                <dt class="font-medium text-slate-600">Customer</dt>
                <dd class="mt-1 text-slate-900"><%= job.customer.name %></dd>
              </dl>
              <span class="<%= status_badge_classes(job.status) %>"><%= job.status.humanize %></span>
            </div>
          </li>
        <% end %>
      </ul>
      <div class="hidden overflow-x-auto md:block" role="region" aria-label="Jobs" tabindex="0">
        <table class="w-full min-w-160 text-left text-sm">
          <thead class="border-b border-slate-300 bg-slate-100 text-xs font-semibold uppercase tracking-wide text-slate-600">
            <tr>
              <th class="min-w-48 px-6 py-3 whitespace-nowrap">Job</th>
              <th class="min-w-48 px-6 py-3 whitespace-nowrap">Customer</th>
              <th class="px-6 py-3 whitespace-nowrap">Status</th>
              <th class="px-6 py-3 whitespace-nowrap text-right"></th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-200">
            <% @jobs.each do |job| %>
              <tr class="hover:bg-slate-50">
                <td class="px-6 py-4">
                  <div class="font-medium text-slate-950">
                    <%= job.name %>
                  </div>

                  <% if job.address.present? %>
                    <div class="mt-1 text-sm text-slate-500">
                      <%= job.address %>
                    </div>
                  <% end %>
                </td>

                <td class="px-6 py-4 text-slate-600">
                  <%= job.customer.name %>
                </td>

                <td class="px-6 py-4">
                  <span class="<%= status_badge_classes(job.status) %>">
                    <%= job.status.humanize %>
                  </span>
                </td>

                <td class="px-6 py-4 whitespace-nowrap text-right">
                  <%= link_to "View",
                      job_path(job),
                      class: "inline-block cursor-pointer rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-slate-400 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% elsif @query.present? || @statuses.any? %>
      <div class="px-6 py-12 text-center">
        <h2 class="font-semibold text-slate-950">No jobs match your filters</h2>
        <p class="mt-1 text-sm text-slate-500">
          <% if (@statuses - Job::STATUSES).any? %>
            Unknown statuses return no jobs. Clear them or choose Reset filters to continue.
          <% else %>
            Try a different search or reset the filters.
          <% end %>
        </p>
      </div>
    <% else %>
      <div class="px-6 py-12 text-center">
        <h2 class="font-semibold text-slate-950">No jobs yet</h2>
        <p class="mt-1 text-sm text-slate-500">
          Create your first job to start tracking work.
        </p>
      </div>
    <% end %>
  </div>
  <%= render "shared/pagination", filters: { q: @query.presence, status: @statuses.presence }.compact, frame: "jobs_results" %>
<% end %>
