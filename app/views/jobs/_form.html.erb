<%= form_with(model: job, class: "space-y-6") do |form| %>
  <%= render "shared/form_errors", record: job, inline_fields: %w[customer name description address status start_date estimated_completion_date] %>

  <div>
    <%= form.label :customer_id, "Customer",
        class: "block text-sm font-medium text-slate-700" %>

    <%= form.collection_select :customer_id,
        @customers,
        :id,
        :name,
        {},
        **field_error_attributes(form, :customer_id, error_attribute: :customer),
        class: "mt-2 block min-w-0 w-full rounded-lg border border-slate-400 bg-white px-3 py-2.5 text-base sm:text-sm text-slate-950 shadow-sm focus:border-slate-500 transition-colors hover:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-500 cursor-pointer" %>
    <%= field_errors(form, :customer_id, error_attribute: :customer) %>
  </div>

  <div>
    <%= form.label :name,
        class: "block text-sm font-medium text-slate-700" %>

    <%= form.text_field :name, **field_error_attributes(form, :name),
        class: "mt-2 block min-w-0 w-full rounded-lg border border-slate-400 bg-white px-3 py-2.5 text-base sm:text-sm text-slate-950 shadow-sm focus:border-slate-500 transition-colors hover:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-500" %>
    <%= field_errors(form, :name) %>
  </div>

  <div>
    <%= form.label :description,
        class: "block text-sm font-medium text-slate-700" %>

    <%= form.textarea :description, **field_error_attributes(form, :description),
        rows: 5,
        class: "mt-2 block min-w-0 w-full rounded-lg border border-slate-400 bg-white px-3 py-2.5 text-base sm:text-sm text-slate-950 shadow-sm focus:border-slate-500 transition-colors hover:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-500" %>
    <%= field_errors(form, :description) %>
  </div>

  <div>
    <%= form.label :address,
        class: "block text-sm font-medium text-slate-700" %>

    <%= form.text_field :address, **field_error_attributes(form, :address),
        class: "mt-2 block min-w-0 w-full rounded-lg border border-slate-400 bg-white px-3 py-2.5 text-base sm:text-sm text-slate-950 shadow-sm focus:border-slate-500 transition-colors hover:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-500" %>
    <%= field_errors(form, :address) %>
  </div>

  <div>
    <%= form.label :status,
        class: "block text-sm font-medium text-slate-700" %>

    <%= form.select :status,
        Job::STATUSES.map { |status| [status.humanize, status] },
        {},
        **field_error_attributes(form, :status),
        class: "mt-2 block min-w-0 w-full rounded-lg border border-slate-400 bg-white px-3 py-2.5 text-base sm:text-sm text-slate-950 shadow-sm focus:border-slate-500 transition-colors hover:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-500 cursor-pointer" %>
    <%= field_errors(form, :status) %>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div class="min-w-0">
      <%= form.label :start_date,
          class: "block text-sm font-medium text-slate-700" %>

      <%= form.date_field :start_date, **field_error_attributes(form, :start_date),
          class: "mt-2 block min-w-0 w-full max-w-full appearance-none rounded-lg border border-slate-400 bg-white px-3 py-2.5 text-base sm:text-sm text-slate-950 shadow-sm focus:border-slate-500 transition-colors hover:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-500" %>
      <%= field_errors(form, :start_date) %>
    </div>

    <div class="min-w-0">
      <%= form.label :estimated_completion_date, "Estimated completion (optional)",
          class: "block text-sm font-medium text-slate-700" %>

      <%= form.date_field :estimated_completion_date, **field_error_attributes(form, :estimated_completion_date, describedby: "estimated-completion-help"),
          class: "mt-2 block min-w-0 w-full max-w-full appearance-none rounded-lg border border-slate-400 bg-white px-3 py-2.5 text-base sm:text-sm text-slate-950 shadow-sm focus:border-slate-500 transition-colors hover:border-slate-500 focus:outline-2 focus:outline-offset-2 focus:outline-slate-500" %>
      <%= field_errors(form, :estimated_completion_date) %>
      <p id="estimated-completion-help" class="mt-2 text-sm text-slate-500">A planned date. Actual completion is recorded when you complete the job.</p>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-3 border-t border-slate-200 pt-6">
    <%= form.submit class: "inline-block cursor-pointer rounded-lg bg-slate-900 px-4 py-2.5 text-center text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>

    <%= link_to "Cancel",
        job.persisted? ? job_path(job) : jobs_path,
        class: "text-sm font-medium text-slate-600 hover:text-slate-950 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 hover:underline underline-offset-4 py-2" %>
  </div>
<% end %>
