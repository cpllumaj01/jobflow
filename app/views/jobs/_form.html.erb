<%= form_with(model: job, class: "space-y-6") do |form| %>
  <% if job.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3">
      <h2 class="text-sm font-semibold text-red-800">
        <%= pluralize(job.errors.count, "error") %> prevented this job from being saved.
      </h2>

      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-700">
        <% job.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :customer_id, "Customer",
        class: "block text-sm font-medium text-slate-700" %>

    <%= form.collection_select :customer_id,
        @customers,
        :id,
        :name,
        {},
        class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-950 shadow-sm outline-none focus:border-slate-500" %>
  </div>

  <div>
    <%= form.label :name,
        class: "block text-sm font-medium text-slate-700" %>

    <%= form.text_field :name,
        class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-950 shadow-sm outline-none focus:border-slate-500" %>
  </div>

  <div>
    <%= form.label :description,
        class: "block text-sm font-medium text-slate-700" %>

    <%= form.textarea :description,
        rows: 5,
        class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-950 shadow-sm outline-none focus:border-slate-500" %>
  </div>

  <div>
    <%= form.label :address,
        class: "block text-sm font-medium text-slate-700" %>

    <%= form.text_field :address,
        class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-950 shadow-sm outline-none focus:border-slate-500" %>
  </div>

  <div>
    <%= form.label :status,
        class: "block text-sm font-medium text-slate-700" %>

    <%= form.select :status,
        Job::STATUSES.map { |status| [status.humanize, status] },
        {},
        class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-950 shadow-sm outline-none focus:border-slate-500" %>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :start_date,
          class: "block text-sm font-medium text-slate-700" %>

      <%= form.date_field :start_date,
          class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-950 shadow-sm outline-none focus:border-slate-500" %>
    </div>

    <div>
      <%= form.label :estimated_completion_date,
          class: "block text-sm font-medium text-slate-700" %>

      <%= form.date_field :estimated_completion_date,
          class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-950 shadow-sm outline-none focus:border-slate-500" %>
    </div>
  </div>

  <div>
    <%= form.label :completed_at,
        class: "block text-sm font-medium text-slate-700" %>

    <%= form.datetime_field :completed_at,
        class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-950 shadow-sm outline-none focus:border-slate-500" %>
  </div>

  <div class="flex items-center gap-3 border-t border-slate-200 pt-6">
    <%= form.submit class: "cursor-pointer rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-700" %>

    <%= link_to "Cancel",
        job.persisted? ? job_path(job) : jobs_path,
        class: "text-sm font-medium text-slate-600 hover:text-slate-950" %>
  </div>
<% end %>
